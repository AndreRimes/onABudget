BETTER_AUTH_SECRET="your-secret-here"

# Drizzle
DATABASE_URL="file:./db.sqlite"

BRAPI_API_TOKEN="secret"
# Bearer token Prometheus must send to scrape /api/metrics.
# Required in production (the endpoint returns 503 without it).
# Generate with: openssl rand -hex 32
METRICS_TOKEN="your-metrics-token-here"
BETTER_AUTH_URL="http://localhost:3000"
NODE_ENV="development"
# Whether the "Criar conta" form is offered. Unset = open in development,
# closed in production. Set to "true" in production only long enough to
# register your own account(s), then remove it.
# ALLOW_SIGNUP="true"

# --- Open Finance (Meu Pluggy) ---------------------------------------------
# Free personal-use Open Finance access. Connect your own accounts at
# https://meu.pluggy.ai, then copy the demo application credentials from
# https://dashboard.pluggy.ai. Leave these unset and the feature stays hidden.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# The only account allowed to see or use the bank sync. Meu Pluggy's free tier
# is licensed for personal use with your own accounts.
OPEN_FINANCE_OWNER_EMAIL=""
